# Copy this file to .env and fill in your values. Never commit .env.

# API
API_KEY=changeme
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compute_arr

# Background poller interval (seconds)
POLL_INTERVAL_SECONDS=90

# Provider API keys
RUNPOD_API_KEY=
VAST_API_KEY=
LAMBDA_API_KEY=
LAMBDA_SSH_KEY_NAMES=["my-ssh-key"]

# Routing baseline provider (for savings calculation in GET /usage)
BASELINE_PROVIDER=lambda
