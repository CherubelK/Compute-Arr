# Copy this file to .env and fill in your values. Never commit .env.

# API
API_KEY=changeme

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compute_arr

# Background poller interval (seconds) and the GPU classes it tracks
POLL_INTERVAL_SECONDS=90
GPU_CLASSES=["H100","A100","A40","RTX4090","RTX3090","RTX3080"]

# Job monitor: how often active jobs are synced with their provider (seconds)
JOB_SYNC_INTERVAL_SECONDS=30

# Failover: max providers tried per job, and how soon after placement a failed
# job still counts as an "early death" worth retrying elsewhere (0 = never)
MAX_PLACEMENT_ATTEMPTS=3
EARLY_DEATH_WINDOW_SECONDS=300

# Provider API keys
RUNPOD_API_KEY=
VAST_API_KEY=
LAMBDA_API_KEY=
LAMBDA_SSH_KEY_NAMES=["my-ssh-key"]

# Routing baseline provider (for savings calculation in GET /usage)
BASELINE_PROVIDER=lambda
